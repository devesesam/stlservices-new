---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/roading06.jpg';
---

<ServiceLayout
  title="Forestry Roading & Clearing in Nelson | Steve Thompson Limited"
  description={`Forest clearing, haul roads, skid sites, landings and slash cleanup around ${site.area} from Steve Thompson Limited.`}
  slug="forestry"
  heading="Forestry"
  intro={[
    'We clear and prepare forestry blocks: haul roads, skid sites, landings and slash cleanup, left safe and tidy.',
    'From harvest support to thinning and restoration, we bring the right machine for the block.',
  ]}
  image={heroImage}
  imageAlt="Forestry road under construction winding across a cleared hillside"
  detailsHeading="Our forestry work"
  detailsIntro={`We work on forestry blocks around ${site.area}, from roading through to cleanup.`}
  items={[
    'Forest clearing and land conversion',
    'Tree thinning and selective harvesting',
    'Skid site preparation and maintenance',
    'Landing construction',
    'Slash management and debris cleanup',
    'Accessway and haul road construction',
    'Erosion control',
  ]}
  ctaTitle="Got a forestry block to work on?"
  ctaDescription="Call Steve, or send a few details about the block for a quote."
/>
