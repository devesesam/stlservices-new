---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/logsplitting03.jpg';
---

<ServiceLayout
  title="Firewood Delivery in Nelson | Steve Thompson Limited"
  description={`Split firewood delivered around ${site.area}, in small loads or bulk. Call Steve Thompson Limited on ${site.phone.display} for this season's prices.`}
  slug="firewood"
  heading="Firewood"
  intro={[
    `Split firewood sourced from forestry operations in the Nelson region, delivered to your door around ${site.area}.`,
    "Small loads or bulk for the season. Call or send a message for this season's prices and availability.",
  ]}
  image={heroImage}
  imageAlt="Firewood being processed with a log splitter"
  detailsHeading="Ordering firewood"
  detailsIntro="Tell us how much you need and where it's going, and we'll sort out the delivery."
  items={[
    'Seasoned hardwood and softwood available',
    'Split and ready to burn',
    'Small loads to bulk deliveries',
    `Delivery around ${site.area}`,
  ]}
  closing={`Prices change through the year, so call Steve on ${site.phone.display} or send a message and we'll let you know what's available. Ordering before winter means you're not caught short.`}
  ctaTitle="Ready to order firewood?"
  ctaDescription="Call Steve, or send a message with how much you need and where."
/>
