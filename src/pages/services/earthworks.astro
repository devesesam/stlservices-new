---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/roading05.jpg';
import crossingBefore from '../../assets/images/crossing01_before.jpg';
import crossingAfter from '../../assets/images/crossing02_after.jpg';
import dam from '../../assets/images/dam01.jpg';
---

<ServiceLayout
  title="Earthworks in Nelson & Tasman | Steve Thompson Limited"
  description={`Site preparation, roading, drainage, land contouring and accessways around ${site.area}. Call Steve Thompson Limited on ${site.phone.display}.`}
  slug="earthworks"
  heading="Earthworks"
  intro={[
    `Site preparation, roads, drainage and land shaping around ${site.area}, done with our own machinery.`,
    "Send a few details about the site and we'll come back to you with a plan and a price.",
  ]}
  image={heroImage}
  imageAlt="Excavator performing earthworks and road building"
  detailsHeading="What we do"
  detailsIntro="From small residential jobs to large forestry developments, we bring the machine and the operator."
  items={[
    'Site preparation and clearing',
    'Road construction and maintenance',
    'Drainage and water tables',
    'Land contouring and levelling',
    'Stream crossings and farm dams',
    'Foundation excavation',
    'Driveways and accessways',
  ]}
  gallery={{
    heading: 'From our earthworks jobs',
    photos: [
      { image: crossingBefore, alt: 'Overgrown gully before a crossing was built', caption: 'Stream crossing: before' },
      { image: crossingAfter, alt: 'New crossing built across the gully', caption: 'Stream crossing: after' },
      { image: dam, alt: 'Excavated farm dam with machinery on the bank', caption: 'Dam construction' },
    ],
  }}
  ctaTitle="Planning some earthworks?"
  ctaDescription="Call Steve, or send a few details about the site for a quote."
/>
