---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/general03.jpg';
---

<ServiceLayout
  title="Motocross Track Building | Steve Thompson Limited"
  description={`Motocross track design, building and maintenance for landowners and clubs around ${site.area}.`}
  slug="motocross-tracks"
  heading="Motocross Tracks"
  intro={[
    'We design, build and maintain motocross tracks: jumps, berms, drainage and surface preparation.',
    "Whether it's a practice track on your own land or a club circuit, we have the earthmoving gear to build it.",
  ]}
  image={heroImage}
  imageAlt="Two excavators on an earthworks site"
  detailsHeading="Track design and construction"
  detailsIntro="Our earthworks experience goes into tracks that ride well and drain properly."
  items={[
    'Track design and layout planning',
    'Jumps, berms and tabletops',
    'Drainage and water management',
    'Track surface preparation',
    'Ongoing maintenance and changes',
    'Start gates and spectator areas',
  ]}
  ctaTitle="Planning a track?"
  ctaDescription="Call Steve, or tell us about the land and the riders you're building for."
/>
