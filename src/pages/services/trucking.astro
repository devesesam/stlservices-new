---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/transporting02.jpg';
---

<ServiceLayout
  title="Trucking & Cartage in Nelson | Steve Thompson Limited"
  description={`Cartage for timber, gravel, firewood and machinery around ${site.area}. Call Steve Thompson Limited on ${site.phone.display}.`}
  slug="trucking"
  heading="Trucking"
  intro={[
    `Cartage for timber, logs, gravel, firewood and machinery around ${site.area}.`,
    'One-off loads or regular runs. Tell us what needs moving and where.',
  ]}
  image={heroImage}
  imageAlt="STL truck transporting heavy equipment"
  detailsHeading="What we cart"
  detailsIntro="Our trucks handle a range of cartage jobs, including moving our own machines to site."
  items={[
    'Timber and log transport',
    'Gravel and aggregate delivery',
    'Firewood delivery',
    'Machinery transport',
    'General cartage and freight',
    'Site-to-site material transfer',
    'Bulk material haulage',
  ]}
  ctaTitle="Need something moved?"
  ctaDescription="Call Steve, or send the details of the load for a quote."
/>
