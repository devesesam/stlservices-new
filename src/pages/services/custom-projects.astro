---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/images/slip04.jpg';
---

<ServiceLayout
  title="Tree Thinning, Slip Clearing & Custom Jobs | Steve Thompson Limited"
  description={`Tree thinning, tree shearing, slip clearing, drainage and other specialist jobs around ${site.area} from Steve Thompson Limited.`}
  slug="custom-projects"
  heading="Custom Projects"
  intro={[
    "Tree thinning, shearing, slip clearing and the jobs that don't fit a standard box.",
    "Tell us what you're dealing with and we'll work out the right approach.",
  ]}
  image={heroImage}
  imageAlt="Excavator loading a truck while clearing a slip from a road"
  detailsHeading="The kind of jobs we take on"
  detailsIntro="Work that goes beyond standard earthworks and forestry, matched to the site and the budget."
  items={[
    'Tree thinning and selective removal',
    'Tree shearing',
    'Vegetation management',
    'Water tables and drainage',
    'Accessway and track construction',
    'Land clearing for development',
    'Road slip clearing',
    'Environmental restoration',
  ]}
  closing="Talk to Steve about your project and we'll put together a plan that works for your needs and budget."
  ctaTitle="Got an unusual job?"
  ctaDescription="Call Steve, or send a few details and we'll work out how to tackle it."
/>
