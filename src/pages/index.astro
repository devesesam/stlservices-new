---
import { site } from '../data/site';
import PageLayout from '../layouts/PageLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import GalleryItem from '../components/GalleryItem.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import { fitWidths, heroWidths } from '../data/images';

// Import images
import heroImage from '../assets/images/bigclearing01.jpg';
import earthworksImage from '../assets/images/roading03.jpg';
import forestryImage from '../assets/images/bigclearing04.jpg';
import truckingImage from '../assets/images/general07.jpg';
import firewoodImage from '../assets/images/logsplitting07.jpg';
import customImage from '../assets/images/treetopping03.jpg';
import motocrossImage from '../assets/images/grading-raking01.jpg';
import firewoodHighlightImage from '../assets/images/logsplitting06.jpg';
import slip01 from '../assets/images/slip01.jpg';
import slip02 from '../assets/images/slip02.jpg';
import slip04 from '../assets/images/slip04.jpg';

const services = [
  {
    href: '/services/earthworks/',
    title: 'Earthworks',
    description: 'Site preparation, roading, drainage and land shaping with our own machinery.',
    image: earthworksImage,
    imageAlt: 'Excavator building forestry access road',
    delay: 'fade-in-delay-1'
  },
  {
    href: '/services/forestry/',
    title: 'Forestry',
    description: 'Forest clearing, skid sites, landings and haul roads, left safe and tidy.',
    image: forestryImage,
    imageAlt: 'Large-scale forestry clearing operation',
    delay: 'fade-in-delay-2'
  },
  {
    href: '/services/trucking/',
    title: 'Trucking',
    description: `Cartage for timber, gravel, firewood and machinery around ${site.area}.`,
    image: truckingImage,
    imageAlt: 'CAT excavator loading a tipper truck',
    delay: 'fade-in-delay-3'
  },
  {
    href: '/services/firewood/',
    title: 'Firewood',
    description: 'Split firewood delivered to your door, in small loads or bulk for the season.',
    image: firewoodImage,
    imageAlt: 'Pile of split firewood',
    delay: 'fade-in-delay-1'
  },
  {
    href: '/services/custom-projects/',
    title: 'Custom Projects',
    description: "Tree thinning, shearing, slip clearing and the jobs that don't fit a standard box.",
    image: customImage,
    imageAlt: 'Tree topping and custom forestry work',
    delay: 'fade-in-delay-2'
  },
  {
    href: '/services/motocross-tracks/',
    title: 'Motocross Tracks',
    description: 'Tracks designed, built and maintained for private landowners and clubs.',
    image: motocrossImage,
    imageAlt: 'Land grading and terrain shaping',
    delay: 'fade-in-delay-3'
  }
];

const galleryImages = [
  { image: slip01, alt: 'Road blocked by a slip with fallen trees', caption: 'A slip blocking a road', delay: 'fade-in-delay-1' },
  { image: slip02, alt: 'Slip damage on a hillside', caption: 'Slip damage on the hillside', delay: 'fade-in-delay-2' },
  { image: slip04, alt: 'Excavator loading a truck while clearing a slip from a road', caption: 'Clearing and carting away the spoil', delay: 'fade-in-delay-3' }
];
---

<PageLayout
  title="Forestry, Earthworks & Firewood in Nelson | Steve Thompson Limited"
  description={`Forestry roading, earthworks, trucking and firewood around ${site.area} from Steve Thompson Limited. Call Steve on ${site.phone.display}.`}
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1>Forestry, earthworks and firewood across {site.area}</h1>
        <p>Steve Thompson Limited builds forestry roads and skid sites, shapes land, carts timber and gravel, and delivers firewood. Talk to Steve directly about your job.</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">Get a quote</a>
          <a href="#services" class="btn btn-outline-dark btn-lg">Our services</a>
        </div>
      </div>
      <div class="hero-image">
        <Image src={heroImage} alt="Aerial view of a CAT excavator working on a forestry road" width={960} widths={fitWidths(heroImage, heroWidths)} quality={70} format="webp" sizes="(max-width: 1024px) calc(100vw - 48px), 470px" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Our Services Section -->
  <section class="section section-dark" id="services">
    <div class="container">
      <div class="section-header fade-in">
        <h2>Our Services</h2>
        <p>Forestry and earthworks across {site.area}</p>
      </div>

      <div class="services-grid">
        {services.map(service => (
          <ServiceCard
            href={service.href}
            title={service.title}
            description={service.description}
            image={service.image}
            imageAlt={service.imageAlt}
            delayClass={service.delay}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Firewood Highlight -->
  <section class="highlight-section" id="firewood-highlight">
    <div class="container">
      <div class="highlight-grid">
        <div class="highlight-content fade-in">
          <h2>Firewood, delivered</h2>
          <p>Split firewood sourced from forestry operations in the Nelson region, delivered to your door around {site.area}. Small loads or bulk for the whole season.</p>
          <p>Prices change through the year, so call Steve or send a message for this season's prices.</p>
          <a href="/services/firewood/" class="btn btn-outline-dark btn-lg">Firewood details</a>
        </div>
        <div class="highlight-image fade-in fade-in-delay-2">
          <Image src={firewoodHighlightImage} alt="Trailer load of split firewood in a cage" width={960} widths={fitWidths(firewoodHighlightImage, [640, 960, 1280])} quality={70} format="webp" sizes="(max-width: 1024px) calc(100vw - 48px), 546px" />
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery / Road Slips -->
  <section class="gallery-section" id="gallery">
    <div class="container">
      <div class="gallery-header fade-in">
        <h2>Clearing road slips</h2>
        <p>From a blocked road to a clear one</p>
      </div>

      <div class="gallery-grid">
        {galleryImages.map(item => (
          <GalleryItem image={item.image} alt={item.alt} caption={item.caption} delayClass={item.delay} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    title="Got a job in mind?"
    description="Call Steve, or send a few details and we'll get back to you with a quote."
  />
</PageLayout>
