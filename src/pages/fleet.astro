---
import { site } from '../data/site';
import PageLayout from '../layouts/PageLayout.astro';
import FleetCard from '../components/FleetCard.astro';
import CTASection from '../components/CTASection.astro';

// Import images
import excavatorImage from '../assets/images/general10.jpg';
import forestryExcavatorImage from '../assets/images/thinning01.jpg';
import truckImage from '../assets/images/transporting01.jpg';
import bulldozerImage from '../assets/images/general08.jpg';
import skidderImage from '../assets/images/skidsite01.jpg';
import splitterImage from '../assets/images/logsplitting01.jpg';

const fleetItems = [
  {
    title: 'CAT Excavator',
    description: 'CAT 313F excavator for earthworks, forestry clearing and land preparation. Available with an experienced operator.',
    image: excavatorImage,
    imageAlt: 'CAT 313F excavator with a bulldozer working behind it',
    delay: 'fade-in-delay-1'
  },
  {
    title: 'Forestry Excavator',
    description: 'Excavator fitted with a forestry head for tree thinning, shearing and clearing.',
    image: forestryExcavatorImage,
    imageAlt: 'CAT excavator with a forestry head working in young pine trees',
    delay: 'fade-in-delay-2'
  },
  {
    title: 'Transport Truck',
    description: `Our own truck for timber, gravel, firewood and machinery cartage around ${site.area}.`,
    image: truckImage,
    imageAlt: 'STL branded Volvo truck carrying a CAT excavator',
    delay: 'fade-in-delay-3'
  },
  {
    title: 'Bulldozer',
    description: 'CAT bulldozer with a ripper for roading, site preparation and large earthmoving jobs.',
    image: bulldozerImage,
    imageAlt: 'CAT bulldozer with a rear ripper parked beside a CAT excavator',
    delay: 'fade-in-delay-1'
  },
  {
    title: 'Log Skidder',
    description: 'Log skidder for timber extraction on forestry blocks and steep terrain.',
    image: skidderImage,
    imageAlt: 'Skid site on a forestry block',
    delay: 'fade-in-delay-2'
  },
  {
    title: 'Wood Splitter',
    description: 'Excavator-mounted wood splitter for processing firewood in volume.',
    image: splitterImage,
    imageAlt: 'Excavator with a splitter attachment processing logs into firewood',
    delay: 'fade-in-delay-3'
  }
];
---

<PageLayout
  title="Our Fleet | Steve Thompson Limited"
  description={`The machinery Steve Thompson Limited runs around ${site.area}: excavators, a bulldozer, a truck, a log skidder and a wood splitter, with operators.`}
  currentPath="/fleet/"
>
  <!-- Fleet Hero -->
  <section class="fleet-hero">
    <div class="container">
      <h1>Our Fleet</h1>
      <p>The machines we bring to the job. Available with experienced operators.</p>
    </div>
  </section>

  <!-- Fleet Grid -->
  <section class="section section-light">
    <div class="container">
      <div class="fleet-grid">
        {fleetItems.map(item => (
          <FleetCard
            title={item.title}
            description={item.description}
            image={item.image}
            imageAlt={item.imageAlt}
            delayClass={item.delay}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    title="Need a machine for your job?"
    description="Tell us about the job and we'll match the right machine and operator."
  />
</PageLayout>
