---
import Logo from './icons/Logo.astro';
import IconChevron from './icons/IconChevron.astro';
import { site, services } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Treat /fleet and /fleet/ as the same page.
const normalise = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalise(currentPath);
const isServicePage = current.startsWith('/services/');
---

<header class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="/" class="nav-logo">
      <Logo />
      {site.name}
    </a>

    <button
      type="button"
      class="mobile-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-menu" id="nav-menu" aria-label="Main">
      <ul class="nav-links">
        <li><a href="/" class:list={[{ active: current === '/' }]} aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
        <li class="nav-dropdown">
          <button
            type="button"
            class:list={['nav-dropdown-toggle', { active: isServicePage }]}
            aria-expanded="false"
            aria-controls="services-menu"
          >
            Services
            <IconChevron />
          </button>
          <ul class="nav-dropdown-menu" id="services-menu">
            {services.map(service => (
              <li>
                <a
                  href={service.href}
                  class:list={[{ active: current === service.href }]}
                  aria-current={current === service.href ? 'page' : undefined}
                >
                  {service.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li><a href="/fleet/" class:list={[{ active: current === '/fleet/' }]} aria-current={current === '/fleet/' ? 'page' : undefined}>Fleet</a></li>
        <li><a href="/contact/" class:list={[{ active: current === '/contact/' }]} aria-current={current === '/contact/' ? 'page' : undefined}>Contact</a></li>
      </ul>

      <div class="nav-actions">
        <a href={site.phone.href} class="btn btn-primary">Call Steve</a>
        <a href={`mailto:${site.email}`} class="btn btn-outline">Email</a>
      </div>
    </nav>
  </div>
</header>
<div class="nav-backdrop" hidden></div>

<script>
  const navbar = document.querySelector<HTMLElement>('.navbar')!;
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle')!;
  const menu = document.getElementById('nav-menu')!;
  const backdrop = document.querySelector<HTMLElement>('.nav-backdrop')!;
  const dropdown = document.querySelector<HTMLElement>('.nav-dropdown')!;
  const dropdownToggle = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-toggle')!;
  // Must match the menu breakpoint in global.css.
  const compact = window.matchMedia('(max-width: 1100px)');

  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  function setDropdown(open: boolean) {
    dropdown.classList.toggle('open', open);
    dropdownToggle.setAttribute('aria-expanded', String(open));
  }

  function setMenu(open: boolean) {
    menu.classList.toggle('open', open);
    toggle.classList.toggle('active', open);
    toggle.setAttribute('aria-expanded', String(open));
    backdrop.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      menu.querySelector<HTMLElement>('a, button')?.focus();
    } else {
      setDropdown(false);
    }
  }

  toggle.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
  backdrop.addEventListener('click', () => setMenu(false));

  dropdownToggle.addEventListener('click', () => {
    setDropdown(!dropdown.classList.contains('open'));
  });

  // Close the dropdown when focus moves elsewhere (desktop keyboard users).
  dropdown.addEventListener('focusout', (e) => {
    if (!compact.matches && !dropdown.contains(e.relatedTarget as Node | null)) setDropdown(false);
  });

  // Close the phone menu when focus leaves the header entirely.
  navbar.addEventListener('focusout', (e) => {
    if (menu.classList.contains('open') && !navbar.contains(e.relatedTarget as Node | null)) setMenu(false);
  });

  document.addEventListener('click', (e) => {
    if (!compact.matches && !dropdown.contains(e.target as Node)) setDropdown(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (dropdown.classList.contains('open')) {
      setDropdown(false);
      dropdownToggle.focus();
    } else if (menu.classList.contains('open')) {
      setMenu(false);
      toggle.focus();
    }
  });

  // Rotating or resizing across the breakpoint resets everything.
  compact.addEventListener('change', () => setMenu(false));

  // Following a link inside the phone menu closes it.
  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
