---
import { Image } from 'astro:assets';
import { fitWidths, cardWidths, cardSizes } from '../data/images';

interface Props {
  image: ImageMetadata;
  alt: string;
  delayClass?: string;
}

const { image, alt, delayClass = '' } = Astro.props;
---

<div class:list={['gallery-item', 'fade-in', delayClass]}>
  <Image src={image} alt={alt} width={800} widths={fitWidths(image, cardWidths)} sizes={cardSizes} quality={70} format="webp" />
</div>
