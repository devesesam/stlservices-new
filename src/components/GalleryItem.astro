---
import { Image } from 'astro:assets';
import { fitWidths, cardWidths, cardSizes } from '../data/images';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  delayClass?: string;
}

const { image, alt, caption, delayClass = '' } = Astro.props;
---

<figure class:list={['gallery-item', 'fade-in', delayClass]}>
  <div class="gallery-item-image">
    <Image src={image} alt={alt} width={800} widths={fitWidths(image, cardWidths)} sizes={cardSizes} quality={70} format="webp" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
