---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
}

const {
  title,
  description,
  primaryText = 'Get a quote',
  primaryHref = '/contact/',
} = Astro.props;
---

<section class="service-cta">
  <div class="container fade-in">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="service-cta-actions">
      <a href={primaryHref} class="btn btn-primary btn-lg">{primaryText}</a>
      <a href={site.phone.href} class="btn btn-outline btn-lg">Call Steve</a>
    </div>
  </div>
</section>
