---
import Logo from './icons/Logo.astro';
import IconPhone from './icons/IconPhone.astro';
import IconEmail from './icons/IconEmail.astro';
import IconLocation from './icons/IconLocation.astro';
import { site, services } from '../data/site';
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">
          <Logo />
          {site.name}
        </div>
        <p class="footer-description">Your trusted partner in forestry solutions across New Zealand. Professional equipment, expert services, and a team that understands the demands of the landscape.</p>
      </div>

      <div>
        <p class="footer-heading">Quick Links</p>
        <div class="footer-links">
          <a href="/">Home</a>
          {services.map(service => <a href={service.href}>{service.label}</a>)}
          <a href="/fleet/">Fleet</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>

      <div>
        <p class="footer-heading">Contact</p>
        <div class="footer-contact-item">
          <IconPhone />
          <a href={site.phone.href}>{site.phone.display}</a>
        </div>
        <div class="footer-contact-item">
          <IconEmail />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="footer-contact-item">
          <IconLocation />
          <span>{site.location}</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</span>
    </div>
  </div>
</footer>
